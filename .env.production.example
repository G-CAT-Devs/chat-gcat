# Copy to .env.production on the VPS; never commit real credentials.
# The new chat1 deployment intentionally starts with its own user/data store.
WEBUI_URL=https://chat1.gcat.ir
WEBUI_AUTH=true
ENABLE_SIGNUP=false
ENABLE_PASSWORD_AUTH=true
# Generate with: openssl rand -hex 32
WEBUI_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET
# Configure your model endpoint in the Open WebUI admin UI, or set these here:
OPENAI_API_BASE_URL=http://host.docker.internal:20128/v1
OPENAI_API_KEY=
OLLAMA_BASE_URL=
